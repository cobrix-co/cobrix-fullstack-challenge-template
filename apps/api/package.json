    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@cobrix/mock-provider": "workspace:*",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
